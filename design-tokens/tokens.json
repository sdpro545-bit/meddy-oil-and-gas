{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "name": "Meddy Oil & Gas Design Tokens",
  "version": "1.0.0",
  "color": {
    "brand": {
      "gold-300": { "value": "#F9DD6F", "description": "Flame top highlight" },
      "amber-400": { "value": "#F2C043", "description": "Drop highlight" },
      "amber-500": { "value": "#FCB424", "description": "Drop core, primary action accent" },
      "orange-500": { "value": "#F69E28", "description": "Flame body / button fill" },
      "orange-600": { "value": "#E08518", "description": "Button hover state" },
      "orange-700": { "value": "#C67117", "description": "Flame & droplet shadow, active button press" },
      "teal-400": { "value": "#7CC1D0", "description": "Wave highlight, focus ring" },
      "blue-600": { "value": "#1A5891", "description": "Wave body" },
      "blue-800": { "value": "#164882", "description": "Deep wave base, primary dark brand tone" }
    },
    "neutral": {
      "ink-950": { "value": "#0B1E36", "description": "Deepest surface, hero scrim base, dark text" },
      "ink-900": { "value": "#102A47", "description": "Solid header on scroll, footer surface" },
      "ink-700": { "value": "#2B4260", "description": "Body text on light backgrounds" },
      "ink-500": { "value": "#5B6E86", "description": "Muted secondary text" },
      "paper-50": { "value": "#F6F8FB", "description": "Light page background" },
      "paper-100": { "value": "#EAEFF5", "description": "Hairlines, subtle borders" },
      "white": { "value": "#FFFFFF", "description": "Pure white surface" }
    },
    "semantic": {
      "bg": { "value": "{color.neutral.paper-50}" },
      "bg-dark": { "value": "{color.neutral.ink-950}" },
      "surface": { "value": "{color.neutral.white}" },
      "surface-dark": { "value": "{color.neutral.ink-900}" },
      "text": { "value": "{color.neutral.ink-950}" },
      "text-muted": { "value": "{color.neutral.ink-700}" },
      "text-on-dark": { "value": "{color.neutral.white}" },
      "accent": { "value": "{color.brand.orange-500}" },
      "accent-hover": { "value": "{color.brand.orange-600}" },
      "accent-press": { "value": "{color.brand.orange-700}" },
      "focus-ring": { "value": "{color.brand.teal-400}" },
      "success": { "value": "#2E7D4F" },
      "danger": { "value": "#B3261E" }
    }
  },
  "typography": {
    "fontFamily": {
      "display": "Barlow Condensed, sans-serif",
      "body": "Manrope, sans-serif"
    },
    "scale": {
      "h1": "clamp(44px, 6.4vw, 92px)",
      "h2": "clamp(34px, 4.4vw, 64px)",
      "h3": "clamp(22px, 2.1vw, 30px)",
      "h4": "18px",
      "eyebrow": "14px",
      "lead": "clamp(17px, 1.4vw, 20px)",
      "body": "16px",
      "small": "14px",
      "button": "15px",
      "ghost": "clamp(96px, 16vw, 240px)"
    }
  },
  "spacing": {
    "base": "8px",
    "scale": {
      "1": "4px",
      "2": "8px",
      "3": "12px",
      "4": "16px",
      "6": "24px",
      "8": "32px",
      "12": "48px",
      "16": "64px",
      "24": "96px",
      "32": "128px"
    },
    "container": {
      "maxWidth": "1320px",
      "paddingInline": "clamp(20px, 4.5vw, 72px)"
    }
  },
  "radius": {
    "button": "2px",
    "card": "4px",
    "tile": "4px",
    "badge": "2px"
  },
  "motion": {
    "easeOut": "cubic-bezier(0.16, 1, 0.3, 1)",
    "easeInOut": "cubic-bezier(0.65, 0, 0.35, 1)",
    "durationFast": "160ms",
    "durationBase": "320ms",
    "durationSlow": "640ms",
    "durationScene": "1100ms"
  }
}
