# Meddy Oil & Gas Environment Configuration
# Leave NEXT_PUBLIC_SITE_EMAIL empty until the client's domain is confirmed.
# When empty, all public email links are hidden and visitors use the contact form.
NEXT_PUBLIC_SITE_EMAIL=

# Resend mail delivery (required for /api/contact to send inquiries)
RESEND_API_KEY=
CONTACT_RECEIVER_EMAIL=
CONTACT_FROM_EMAIL=
